{
  "openapi": "3.0.3",
  "info": {
    "title": "Directory (older protocol)",
    "version": "1.0"
  },
  "paths": {},
  "components": {
    "securitySchemes": {
      "key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "token": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "key": []
    },
    {
      "token": []
    }
  ],
  "x-tyk-api-gateway": {
    "info": {
      "id": "older",
      "orgId": "default",
      "name": "Directory (older protocol)",
      "state": {
        "active": true
      }
    },
    "server": {
      "listenPath": {
        "value": "/older/",
        "strip": true
      },
      "authentication": {
        "enabled": true,
        "stripAuthorizationData": true,
        "securitySchemes": {
          "key": {
            "enabled": true
          },
          "token": {
            "enabled": true,
            "header": {
              "enabled": true,
              "name": "Authorization"
            },
            "jwksURIs": [
              {
                "url": "env://MCP_TOKEN_JWKS_URL",
                "cacheTimeout": "5m"
              }
            ],
            "signingMethod": "rsa",
            "identityBaseField": "sub",
            "defaultPolicies": [
              "example-tokens"
            ],
            "allowedIssuers": [
              "env://MCP_TOKEN_ISSUER"
            ],
            "allowedAudiences": [
              "env://MCP_TOKEN_AUDIENCE"
            ]
          }
        },
        "securityProcessingMode": "compliant"
      }
    },
    "upstream": {
      "url": "http://older:8000/mcp"
    },
    "middleware": {
      "global": {
        "pluginConfig": {
          "driver": "goplugin"
        },
        "contextVariables": {
          "enabled": true
        },
        "postPlugins": [
          {
            "enabled": true,
            "functionName": "Authorize",
            "path": "/opt/tyk-gateway/middleware/mcp-pdp.so"
          }
        ],
        "postAuthenticationPlugins": [
          {
            "enabled": true,
            "functionName": "Capture",
            "path": "/opt/tyk-gateway/middleware/mcp-pdp.so"
          }
        ],
        "responsePlugins": [
          {
            "enabled": true,
            "functionName": "CheckResponse",
            "path": "/opt/tyk-gateway/middleware/mcp-pdp.so"
          }
        ]
      }
    }
  }
}
