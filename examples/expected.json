    {"caller": "analyst", "server": "directory", "tool": "update_person", "arguments": {"id": "7", "name": "Ada"}, "expect": "refused", "why": "writes; analysts only read"},
    {"caller": "analyst", "server": "directory", "tool": "export_directory", "arguments": {"destination": "/tmp/x"}, "expect": "refused", "why": "operator says read-only, upstream says it writes: the annotation narrows"},
