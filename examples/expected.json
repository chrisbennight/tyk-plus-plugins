    "deployer": {"directory": ["codemode.describe", "codemode.execute", "codemode.limits", "codemode.search", "delete_person", "export_directory", "get_person", "search", "update_person"], "payments": ["codemode.describe", "codemode.execute", "codemode.limits", "codemode.search", "get_balance", "refund", "transfer"], "notes": ["codemode.describe", "codemode.execute", "codemode.limits", "codemode.search", "export", "purge", "search"], "older": ["get_person", "search", "update_person"], "changing": ["lookup", "report", "update"]}
