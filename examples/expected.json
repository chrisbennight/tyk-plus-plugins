  "refusedCallers": ["no-credential", "expired-token", "other-audience-token", "no-subject-token", "unpublished-key-token", "malformed-roles-token", "key-without-metadata", "key-and-token", "unknown-key-and-token"],
  "codeMode": {
    "proxies": ["directory", "payments", "notes"],
    "programs": [
      {"caller": "analyst", "server": "directory", "why": "a program across two servers gets the analyst's own outcomes", "expect": "permitted", "calls": [
        {"server": "directory", "tool": "search", "arguments": {"query": "ada"}, "expect": "permitted"},
        {"server": "payments", "tool": "get_balance", "arguments": {"account": "ops"}, "expect": "permitted"},
        {"server": "directory", "tool": "update_person", "arguments": {"id": "7", "name": "Ada"}, "expect": "refused"},
        {"server": "payments", "tool": "refund", "arguments": {"amount": 5, "environment": "staging"}, "expect": "refused"}
      ]},
      {"caller": "indexer", "server": "notes", "why": "a key caller's program gets the key's outcomes", "expect": "permitted", "calls": [
        {"server": "notes", "tool": "export", "arguments": {"format": "csv"}, "expect": "permitted"},
        {"server": "directory", "tool": "search", "arguments": {"query": "ada"}, "expect": "permitted"},
        {"server": "directory", "tool": "update_person", "arguments": {"id": "7", "name": "Ada"}, "expect": "refused"}
      ]},
      {"caller": "finance", "server": "payments", "why": "no rule lets the finance group run programs", "expect": "refused", "calls": []}
    ]
  },
  "drift": {
    "server": "changing",
    "caller": "deployer",
    "instructions": "Look up a record with lookup, change it with update, and summarize a period with report.",
    "arguments": {"lookup": {"id": "7"}, "update": {"id": "7", "value": "new"}, "report": {"period": "week"}, "delete": {"id": "7"}, "summary": {"period": "week"}},
    "steps": [
      {"version": 1, "why": "lookup's description gains text addressed to the model", "listed": ["report", "update"], "permitted": ["report", "update"], "refused": ["lookup"]},
      {"version": 2, "why": "lookup's description gains hidden and look-alike characters", "listed": ["report", "update"], "permitted": ["report", "update"], "refused": ["lookup"]},
      {"version": 3, "why": "lookup gains a parameter", "listed": ["report", "update"], "permitted": ["report", "update"], "refused": ["lookup"]},
      {"version": 4, "why": "update now claims to be read-only", "listed": ["lookup", "report"], "permitted": ["lookup", "report"], "refused": ["update"]},
      {"version": 5, "why": "a new tool appears and is held until approved", "listed": ["lookup", "report", "update"], "permitted": ["lookup", "report", "update"], "refused": ["delete"]},
      {"version": 6, "why": "report is no longer listed; the other tools are unaffected", "listed": ["lookup", "update"], "permitted": ["lookup", "update"], "refused": []},
      {"version": 7, "why": "report is renamed: the new name is a new tool", "listed": ["lookup", "update"], "permitted": ["lookup", "update"], "refused": ["summary"]},
      {"version": 8, "why": "only the instructions change: the approved ones are still given", "listed": ["lookup", "report", "update"], "permitted": ["lookup", "report", "update"], "refused": []},
      {"version": 9, "why": "only _meta changes, which is not a change", "listed": ["lookup", "report", "update"], "permitted": ["lookup", "report", "update"], "refused": []},
      {"version": 10, "why": "a second change to lookup while the first waits for review", "listed": ["report", "update"], "permitted": ["report", "update"], "refused": ["lookup"]},
      {"version": 0, "why": "back to the approved tools: lookup works again", "listed": ["lookup", "report", "update"], "permitted": ["lookup", "report", "update"], "refused": []}
    ]
  }
