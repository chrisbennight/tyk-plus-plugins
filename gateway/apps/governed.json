{
  "name": "Governed MCP",
  "api_id": "governed",
  "org_id": "default",
  "is_oas": true,
  "application_protocol": "mcp",
  "json_rpc_version": "2.0",
  "auth_configs": {"authToken": {"auth_header_name": "Authorization"}},
  "strip_auth_data": true,
  "version_data": {"not_versioned": true, "versions": {"Default": {"name": "Default", "use_extended_paths": true}}},
  "proxy": {"listen_path": "/mcp/", "target_url": "env://MCP_UPSTREAM_URL", "strip_listen_path": true},
  "custom_middleware": {"driver": "goplugin", "post_key_auth": [{"name": "Authorize", "path": "/opt/tyk-gateway/middleware/cedar.so"}]}
}
