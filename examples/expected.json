    {"caller": "admin", "server": "directory", "tool": "export_directory", "arguments": {"destination": "/tmp/x"}, "expect": "permitted", "why": "administrators are exempt from the narrowing"},
    {"caller": "admin", "server": "directory", "tool": "delete_person", "arguments": {"id": "7"}, "expect": "refused", "why": "deletion is reserved to the deployment service, even over the admin grant"},
    {"caller": "deployer", "server": "directory", "tool": "delete_person", "arguments": {"id": "7"}, "expect": "permitted", "why": "the deployment service may delete"},
    {"caller": "indexer", "server": "directory", "tool": "search", "arguments": {"query": "ada"}, "expect": "permitted", "why": "a key caller with the analyst role reads"},
    {"caller": "indexer", "server": "directory", "tool": "update_person", "arguments": {"id": "7", "name": "Ada"}, "expect": "refused", "why": "a key caller with the analyst role cannot write"},
    {"caller": "finance", "server": "directory", "tool": "search", "arguments": {"query": "ada"}, "expect": "refused", "why": "no rule grants the finance group the directory"},
    {"caller": "analyst", "server": "payments", "tool": "get_balance", "arguments": {"account": "ops"}, "expect": "permitted", "why": "read-only by operator fact"},
    {"caller": "analyst", "server": "payments", "tool": "refund", "arguments": {"amount": 5, "environment": "test"}, "expect": "permitted", "why": "analysts may refund in test"},
    {"caller": "analyst", "server": "payments", "tool": "refund", "arguments": {"amount": 5, "environment": "staging"}, "expect": "refused", "why": "the refund grant names only the test environment"},
    {"caller": "analyst", "server": "payments", "tool": "transfer", "arguments": {"amount": 5, "environment": "test"}, "expect": "refused", "why": "same server, different tool: analysts may not transfer"},
    {"caller": "finance", "server": "payments", "tool": "transfer", "arguments": {"amount": 5, "environment": "test"}, "expect": "permitted", "why": "the finance group may use payment tools"},
    {"caller": "finance", "server": "payments", "tool": "transfer", "arguments": {"amount": 5, "environment": "production"}, "expect": "refused", "why": "nobody moves money in production"},
    {"caller": "admin", "server": "payments", "tool": "refund", "arguments": {"amount": 5, "environment": "production"}, "expect": "refused", "why": "the production forbid beats the admin grant"},
    {"caller": "finance", "server": "payments", "tool": "refund", "arguments": {"amount": "5", "environment": "test"}, "expect": "refused", "why": "an argument of the wrong type"},
    {"caller": "analyst", "server": "notes", "tool": "search", "arguments": {"query": "plan"}, "expect": "refused", "why": "declares nothing, so there is no read-only fact to rely on"},
    {"caller": "scoped", "server": "notes", "tool": "search", "arguments": {"query": "plan"}, "expect": "permitted", "why": "the notes:read scope grants search"},
    {"caller": "scoped", "server": "notes", "tool": "purge", "arguments": {"count": 1}, "expect": "refused", "why": "the scope grants search only"},
    {"caller": "analyst", "server": "notes", "tool": "purge", "arguments": {"count": 1}, "expect": "refused", "why": "claims to be read-only; the claim grants nothing"},
    {"caller": "indexer", "server": "notes", "tool": "export", "arguments": {"format": "csv"}, "expect": "permitted", "why": "the indexing service may export; analysts may not"},
    {"caller": "analyst", "server": "notes", "tool": "export", "arguments": {"format": "csv"}, "expect": "refused", "why": "_meta says read-only, but only operator facts count"},
    {"caller": "admin", "server": "notes", "tool": "archive", "arguments": {"id": "1"}, "expect": "refused", "why": "never approved: refused like a tool that does not exist"},
    {"caller": "admin", "server": "notes", "tool": "no_such_tool", "arguments": {}, "expect": "refused", "why": "a tool that does not exist"},
    {"caller": "analyst", "server": "older", "tool": "search", "arguments": {"query": "ada"}, "expect": "permitted", "why": "read-only by operator fact"},
    {"caller": "analyst", "server": "older", "tool": "update_person", "arguments": {"id": "7", "name": "Ada"}, "expect": "refused", "why": "writes; analysts only read"},
    {"caller": "admin", "server": "older", "tool": "delete_person", "arguments": {"id": "7"}, "expect": "refused", "why": "never approved on this proxy"},
    {"caller": "analyst", "server": "changing", "tool": "lookup", "arguments": {"id": "7"}, "expect": "permitted", "why": "read-only by operator fact"},
    {"caller": "analyst", "server": "changing", "tool": "update", "arguments": {"id": "7", "value": "new"}, "expect": "refused", "why": "writes; analysts only read"}
  ],
  "listed": {
    "analyst": {"directory": ["codemode.describe", "codemode.execute", "codemode.limits", "codemode.search", "get_person", "search"], "payments": ["codemode.describe", "codemode.execute", "codemode.limits", "codemode.search", "get_balance", "refund"], "notes": ["codemode.describe", "codemode.execute", "codemode.limits", "codemode.search"], "older": ["get_person", "search"], "changing": ["lookup", "report"]},
