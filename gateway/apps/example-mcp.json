{
  "openapi": "3.0.3",
  "info": {"title": "Example MCP", "version": "1.0"},
  "paths": {
    "/tools/call": {"post": {"operationId": "toolsCall", "responses": {"200": {"description": "Tool result"}}}}
  },
  "x-tyk-api-gateway": {
    "info": {"id": "example", "orgId": "default", "name": "Example MCP", "state": {"active": true}},
    "server": {"listenPath": {"value": "/mcp/", "strip": true}, "authentication": {"enabled": false}},
    "upstream": {"url": "http://example:8000/mcp"},
    "middleware": {"mcpTools": {"echo": {"allow": {"enabled": true}}}}
  }
}
